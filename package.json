{
  "name": "hypher",
  "version": "0.2.5",
  "description": "A fast and small hyphenation engine",
  "author": "mLengse (medotsys@gmail.com)",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "benchmark": "^2.1.4",
    "jest": "^29.7.0",
    "rollup": "^4.62.3"
  },
  "directories": {
    "lib": "./lib"
  },
  "scripts": {
    "test": "jest --verbose",
    "build": "rollup -c rollup.config.mjs && node -e \"var fs=require('fs');var pre=fs.readFileSync('lib/hypher.browser.pre.js','utf8');var core=fs.readFileSync('lib/hypher.js','utf8');var post=fs.readFileSync('lib/hypher.browser.post.js','utf8');var jq=fs.readFileSync('lib/jquery.hypher.js','utf8');fs.writeFileSync('dist/jquery.hypher.js',pre+core+post+jq);\"",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/mlengse/Hypher.git"
  },
  "keywords": [
    "hyphenation",
    "hypher",
    "hypher.js",
    "ender",
    "jquery",
    "indonesian",
    "bahasa",
    "bahasa-indonesia",
    "kbbi"
  ],
  "engines": {
    "node": ">=14"
  },
  "license": "BSD-3-Clause",
  "main": "./lib/hypher.js",
  "exports": {
    ".": {
      "import": "./lib/hypher.mjs",
      "require": "./lib/hypher.js",
      "default": "./lib/hypher.js"
    },
    "./lib/patterns/*.js": "./lib/patterns/*.js",
    "./package.json": "./package.json"
  },
  "ender": "./lib/ender.js"
}
